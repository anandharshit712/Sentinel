# Sentinel configuration. Copy to .env (gitignored) and fill in what you use.
# Host-native dev reads it directly; Docker reads it with
#   docker compose -f deploy/compose.yaml --env-file .env up
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---------------------------------------------------------------- LLM (NVIDIA NIM)
# REQUIRED for self-host. In hosted mode leave it unset on purpose: each account brings its own key.
NVIDIA_API_KEY=
# Whole-network model override (config/custom_llm_info.hocon alias).
MODEL_NAME=nvidia-nemotron-3-ultra
# sly_data = every run uses only the key the Gateway hands it (BYOK). Required for AUTH_MODE=oidc.
LLM_KEY_SOURCE=

# ---------------------------------------------------------------- database
# Host-native: your local Postgres 17, schema `sentinel`, a NON-superuser role (superusers bypass
# row-level security). Docker: built from the passwords below; DATABASE_URL is ignored.
DATABASE_URL=postgresql+psycopg://sentinel:CHANGE_ME@localhost:5432/sentinel
POSTGRES_PASSWORD=          # Docker only, REQUIRED: postgres superuser (first boot)
SENTINEL_DB_PASSWORD=       # Docker only, REQUIRED: the application role
KEYCLOAK_DB_PASSWORD=       # Docker hosted profile only

# ---------------------------------------------------------------- neuro-san server (host-native)
AGENT_MANIFEST_FILE=registries/manifest.hocon
AGENT_TOOL_PATH=coded_tools
AGENT_LLM_INFO_FILE=config/custom_llm_info.hocon
AGENT_HTTP_PORT=8080
AGENT_SERVICE_LOG_JSON=logging.hocon
THINKING_DIR=logs/thinking_dir

# ---------------------------------------------------------------- gateway
GATEWAY_PORT=8000
NEURO_SAN_HOST=localhost
NEURO_SAN_PORT=8080
INVOKE_TIMEOUT_SECONDS=3700
# tokens = shared tokens below, one tenant (self-host). oidc = Keycloak accounts (hosted).
AUTH_MODE=tokens
# AUTH_MODE=tokens: comma list of <token>:<role>, roles viewer|approver|admin.
API_TOKENS=
# Opt-in, dev only: every request is admin when no API_TOKENS are set.
SENTINEL_OPEN_MODE=
# Comma list of repo.name values simulate may run (empty = any).
SENTINEL_REPO_ALLOWLIST=
# Git SHA stamped on every run (images bake it; host-native falls back to git rev-parse).
SENTINEL_VERSION=

# ---------------------------------------------------------------- per-run sandbox
# local = plain subprocess (dev); docker = every repo-executing call runs in a per-run container.
SANDBOX_MODE=local
SANDBOXD_URL=http://127.0.0.1:8090
SANDBOXD_TOKEN=             # REQUIRED for docker mode / compose
SANDBOX_IMAGE=sentinel-sandbox:latest
SANDBOX_RUNTIME=runc        # runsc = gVisor (hosted, Linux only)
SANDBOX_PIDS_LIMIT=256
SANDBOX_NETWORK=sentinel-sandbox
WORKSPACE_ROOT=             # default: <system temp>/sentinel-workspaces
SANDBOX_WORKSPACE_ROOTS=    # sandboxd: allowed parents of mounted workspaces (default: system temp)

# ---------------------------------------------------------------- hosted mode (AUTH_MODE=oidc)
PUBLIC_URL=http://localhost:8000
KEYCLOAK_URL=http://localhost:8180          # as the browser sees it
KEYCLOAK_INTERNAL_URL=                      # as the Gateway reaches it (compose sets this)
KEYCLOAK_REALM=sentinel
KEYCLOAK_CLIENT_ID=sentinel-gateway
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# Fernet key for stored LLM keys:  python -m lib.secretbox --new-key
SENTINEL_SECRET_KEY=
SENTINEL_ADMIN_EMAILS=                      # comma list; these accounts get the Admin screen
CI_OIDC_AUDIENCE=sentinel                   # `aud` GitHub/GitLab job tokens must request
GITLAB_URL=https://gitlab.com
QUOTA_RUNS_PER_DAY_ACCOUNT=50
QUOTA_RUNS_PER_DAY_REPO=20
MAX_REPO_MB=500
# Code-host sign-in (OAuth apps you create; callback http://localhost:8180/realms/sentinel/broker/<github|gitlab>/endpoint)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_SCOPE=read:user user:email     # add `repo` to register private GitHub repos
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
# Keycloak email verification (optional for local; required to verify real users)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------- misc
SENTINEL_LICENSE_LOOKUP=on                  # off = licence cache only (air-gapped)
FALLBACK_MODEL_NAME=
