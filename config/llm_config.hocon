{
    # NVIDIA NIM. Included by registries/sentinel.hocon (04 §6.1). Providers without keys are culled.
    # `fallbacks` are tried in order and fallbacks[0] is the effective primary — the top-level
    # `model_name` override does NOT reorder them (verified in B1: with 70B first the network timed
    # out even with MODEL_NAME set). So the WORKING dev model goes first.
    # NIM retires models: the previous primary `mistralai/mistral-small-4-119b-2603` went EOL
    # 2026-07-27 and now returns HTTP 410, which broke every agent call. Re-probe with
    # `GET /v1/models` + a tool-call request before trusting anything here (2026-08-16).
    "fallbacks": [
        # Working dev primary, form B = class:nvidia + RAW NIM id (a bare key with class -> 404). (rule 3)
        # Verified 2026-08-16: emits structured tool calls, ~1.2-1.9s on a probe request.
        { "class": "nvidia", "model_name": "nvidia/nemotron-3-super-120b-a12b", "temperature": 0.1 },
        # Fallback. Was z-ai/glm-5.2 until NIM retired it on 2026-08-21 (HTTP 410), leaving the
        # network with NO live fallback. gpt-oss-20b scored 9/9 recall / 0 FPs in the bake-off
        # (docs/model-evaluation.md §3) and probes 3/3 with tool calls at ~1-4s (2026-09-20).
        # Was openai/gpt-oss-20b, which probed 0/2 (120s timeouts) on 2026-09-25 having been fine
        # days earlier. nemotron-3-ultra probed 2/2 the same minute, having itself been timing out
        # all week — NIM's per-model health swings hour to hour, so this order is a snapshot, not a
        # ranking. Re-probe (scripts/probe_models.py) before trusting it.
        { "class": "nvidia", "model_name": "nvidia/nemotron-3-ultra-550b-a55b", "temperature": 0.1 },
        # Third rung, added 2026-09-23 during a NIM-wide bad patch: the primary was returning 500s
        # and gpt-oss-20b was timing out at 90s, while this one still answered with tool calls
        # (slowly, ~112s). Slow-but-alive is what keeps a run from dying — the 2026-09-20 outage
        # was survivable only because SOMETHING below the primary still worked.
        { "class": "nvidia", "model_name": "z-ai/glm-5.3-flash", "temperature": 0.1 },
        # meta/llama-3.3-70b-instruct (the originally documented primary) is deliberately NOT here:
        # it still times out at 120s on the public NIM endpoint.
        { "model_name": ${?FALLBACK_MODEL_NAME} }     # optional 2nd provider (gpt-4o / claude); ignored if unset
    ],
    "model_name": ${?MODEL_NAME}                       # whole-network override, wins when set
}
