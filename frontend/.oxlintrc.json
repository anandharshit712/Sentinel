{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    // lib.tsx deliberately groups the design-system exports (chips, cards, gauges) with the data
    // hooks that every screen imports alongside them. This rule is a dev-server hot-reload
    // concern only — it costs a component remount on edit, never correctness — and splitting the
    // file to satisfy it would scatter one cohesive module across four import sites.
    "react/only-export-components": "off"
  }
}
